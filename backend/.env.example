# Database (Supabase / Railway / Render Postgres / local)
DATABASE_URL="postgresql://user:password@host:5432/famfin?schema=public"

# JWT
JWT_SECRET="ganti-dengan-random-string-yang-panjang-dan-rahasia"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development

# CORS - domain frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGIN="http://localhost:5173"

# URL frontend - dipakai untuk membuat link reset password di email
FRONTEND_URL="http://localhost:5173"

# SMTP (opsional untuk development).
# Jika kosong, email hanya dicetak ke console (mode dev) - cocok untuk testing lokal.
# Untuk production, isi dengan provider gratis seperti Resend (resend.com) atau Brevo (brevo.com).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FamFin <no-reply@famfin.app>"
